<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Curio Collective</title>
    <link rel="stylesheet" href="/home.css">
</head>
<body>
    <header>
        <div class="logo"><strong>Curio</strong> Collective</div>
        <nav>
            <a href="/">HOME</a>
            <a href="/shop">SHOP</a>
            <a href="#">NEW ARRIVALS</a>
            <a href="#">BESTSELLERS</a>
        </nav>
    </header>

    <section class="hero">
        <div class="hero-content">
            <h1>FIND JOY IN THE UNIQUE</h1>
            <p>Explore our collection of handpicked curiosities.</p>
            <button class="btn-primary">SHOP ALL COLLECTIONS</button>
        </div>
    </section>

    <div class="main-layout">
        <aside class="sidebar">
            <h3>CATEGORIES</h3>
            <ul>
                <li>Toys & Games</li>
                <li>Jewelry</li>
                <li>Caps & Hats</li>
                <li>Kitchenware</li>
                <li>Books</li>
            </ul>
        </aside>

        <main class="product-section">
            <div class="product-grid">
                <% items.forEach(item => { %>
                    <div class="product-card">
                        <img src="<%= item.image %>" alt="<%= item.products %>" class="product-image">
                        <h3><%= item.products %></h3>
                        <p class="category"><%= item.category %></p>
                        <p class="price">$<%= item.price %></p>
                        <button class="add-to-cart">ADD TO CART</button>
                    </div>
                <% }); %>
            </div>
        </main>
    </div>
</body>
</html>