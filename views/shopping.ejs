<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curio Collective | Shop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f9f8f6; /* Off-white/Cream background from image */
            color: #333;
        }
        .product-card {
            background: white;
            border-radius: 8px;
            transition: transform 0.2s ease;
        }
        .product-card:hover {
            transform: translateY(-4px);
        }
        .btn-primary {
            background-color: #fff;
            border: 1px solid #d1d1d1;
            border-radius: 4px;
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 600;
        }
        .btn-primary:hover {
            background-color: #f3f3f3;
        }
    </style>
</head>
<body>

    <header class="bg-white border-b border-stone-200 py-6">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <h1 class="text-2xl font-serif font-bold tracking-tight">Curio Collective</h1>
            <nav class="hidden md:flex space-x-8 text-sm font-medium uppercase tracking-widest text-stone-600">
                <a href="#">Home</a>
                <a href="#" class="text-black border-b border-black">Shop</a>
                <a href="#">New Arrivals</a>
                <a href="#">About</a>
                <a href="#">Contact</a>
            </nav>
            <div class="flex items-center space-x-4">
                <span>Search</span>
                <span>Cart (0)</span>
            </div>
        </div>
    </header>

    <main class="container mx-auto px-4 py-12 flex flex-col md:flex-row gap-12">
        
        <aside class="w-full md:w-1/4">
            <h2 class="text-xs font-bold uppercase tracking-widest mb-6 border-b pb-2">Categories</h2>
            <ul class="space-y-4 text-sm text-stone-700">
                <% categories.forEach(category => { %>
                    <li class="flex items-center hover:text-black cursor-pointer">
                        <span class="mr-2">◈</span> <%= category %>
                    </li>
                <% }) %>
            </ul>
        </aside>

        <section class="w-full md:w-3/4">
            <div class="flex justify-between items-end mb-8">
                <h2 class="text-xs font-bold uppercase tracking-widest">New Arrivals</h2>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
                <% items.forEach(item => { %>
                    <div class="product-card p-4 flex flex-col items-center">
                        <div class="aspect-square w-full bg-stone-100 rounded-lg mb-4 overflow-hidden">
                            <img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-full object-cover">
                        </div>
                        <div class="text-center w-full">
                            <h3 class="text-sm font-semibold text-stone-800 truncate"><%= item.name %></h3>
                            <p class="text-sm text-stone-500 mb-1">$<%= item.price %></p>
                            
                            <div class="flex justify-center mb-3 text-[10px] text-yellow-500">
                                ★★★★☆
                            </div>

                            <button class="btn-primary w-full py-2">Add to Cart</button>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

    </main>

    <footer class="bg-stone-100 mt-20 py-12 border-t border-stone-200">
        <div class="container mx-auto px-4 text-center">
            <p class="text-xs text-stone-500 uppercase tracking-widest">&copy; 2024 Curio Collective</p>
        </div>
    </footer>

</body>
</html>